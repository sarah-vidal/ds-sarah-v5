# Documentation seulement : aucun chargement automatique de .env.
# Définissez ces variables dans le terminal si nécessaire.
PORT=4310
# DS_STUDIO_DATA_DIR=chemin-vers-un-dossier-prive
# Aucun identifiant requis pour le mode manuel.

# --- Figma optionnel, lecture seule ---
# Créez une application OAuth Figma et enregistrez exactement cette URL de
# redirection : http://127.0.0.1:4310/api/figma/oauth/callback
# FIGMA_CLIENT_ID=
# FIGMA_CLIENT_SECRET=
# Scopes par défaut (styles, composants, profil). Ajoutez file_variables:read
# uniquement si votre plan Enterprise autorise l’API Variables.
# FIGMA_SCOPES=current_user:read,file_content:read
# À ne définir que si le port ou l’URL de redirection changent.
# FIGMA_REDIRECT_URI=http://127.0.0.1:4310/api/figma/oauth/callback

# Les jetons OAuth sont conservés uniquement dans .ds-studio/figma.json,
# jamais renvoyés au navigateur et jamais commités.
